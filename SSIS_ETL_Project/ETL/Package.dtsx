          DTS:ObjectName="SQL_Update_Watermark"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="UPDATE dbo.ETL_Watermark&#xA;SET last_run_time = SYSDATETIME(),&#xA;    total_rows_last = (SELECT COUNT(*) FROM dbo.Fact_Sales)&#xA;WHERE table_name = 'stg_sales_full';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
