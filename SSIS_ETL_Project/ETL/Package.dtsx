              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;-- 1. E01: Thiếu thông tin bắt buộc (NULL)&#xA;INSERT INTO dbo.etl_reject (batch_id, source_table, natural_key, reject_category, reject_reason, raw_data_snippet)&#xA;SELECT @batch_id, 'stg_sales_full', s.order_id, 'E01_NULL_REQUIRED',&#xA;    CONCAT(CASE WHEN s.order_id IS NULL THEN '[order_id NULL] ' ELSE '' END,&#xA;           CASE WHEN s.customer_id IS NULL THEN '[customer_id NULL] ' ELSE '' END,&#xA;           CASE WHEN s.order_date IS NULL THEN '[order_date NULL] ' ELSE '' END),&#xA;    CONCAT('order_id=', s.order_id, '; cust=', s.customer_id)&#xA;FROM dbo.stg_sales_full s&#xA;WHERE s.order_id IS NULL OR s.customer_id IS NULL OR s.order_date IS NULL;&#xA;&#xA;-- 2. E02: Lỗi ép kiểu / Định dạng&#xA;INSERT INTO dbo.etl_reject (batch_id, source_table, natural_key, reject_category, reject_reason, raw_data_snippet)&#xA;SELECT @batch_id, 'stg_sales_full', s.order_id, 'E02_TYPE_MISMATCH',&#xA;    N'[Dữ liệu ngày đặt hoặc số lượng không đúng kiểu]',&#xA;    CONCAT('date=', s.order_date, '; qty=', s.quantity)&#xA;FROM dbo.stg_sales_full s&#xA;WHERE (TRY_CONVERT(DATE, s.order_date) IS NULL AND s.order_date IS NOT NULL)&#xA;   OR (TRY_CONVERT(INT, s.quantity) IS NULL AND s.quantity IS NOT NULL);&#xA;&#xA;-- 3. E03: Vi phạm quy tắc nghiệp vụ (Số lượng &lt;= 0, Doanh số &lt; 0)&#xA;INSERT INTO dbo.etl_reject (batch_id, source_table, natural_key, reject_category, reject_reason, raw_data_snippet)&#xA;SELECT @batch_id, 'stg_sales_full', s.order_id, 'E03_BUSINESS_RULE',&#xA;    N'[Số lượng &lt;= 0 hoặc Chiết khấu vượt Doanh số]',&#xA;    CONCAT('qty=', s.quantity, '; gross=', s.gross_sales, '; disc=', s.discount_amount)&#xA;FROM dbo.stg_sales_full s&#xA;WHERE TRY_CONVERT(INT, s.quantity) &lt;= 0&#xA;   OR TRY_CONVERT(DECIMAL(18,4), s.discount_amount) &gt; TRY_CONVERT(DECIMAL(18,4), s.gross_sales);&#xA;&#xA;-- 4. E05: Trùng lặp tự nhiên trong chi tiết đơn hàng&#xA;INSERT INTO dbo.etl_reject (batch_id, source_table, natural_key, reject_category, reject_reason, raw_data_snippet)&#xA;SELECT @batch_id, 'stg_order_items', CONCAT(order_id, ' / ', product_id), 'E05_DUPLICATE',&#xA;    N'[Trùng lặp cặp khóa (order_id, product_id)]',&#xA;    CONCAT('order_id=', order_id, '; prod_id=', product_id)&#xA;FROM dbo.stg_order_items&#xA;GROUP BY order_id, product_id&#xA;HAVING COUNT(*) &gt; 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03_Transform_And_Load_Dimensions"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{6e91830d-2750-4a33-b252-dff3862ce07c}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="03_Transform_And_Load_Dimensions">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Customer_SCD2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A3BFE137-9C1E-44AA-A6E9-C3E332305F0E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Customer_SCD2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;DECLARE @today DATE = CAST(GETDATE() AS DATE);&#xA;&#xA;BEGIN TRY&#xA;    -- 1. Đóng phiên bản cũ&#xA;    UPDATE d&#xA;    SET d.is_current = 0, d.effective_end = @today&#xA;    FROM dbo.Dim_Customer d&#xA;    INNER JOIN dbo.stg_customer_master s ON d.customer_id = s.customer_id&#xA;    WHERE d.is_current = 1 &#xA;      AND (ISNULL(d.customer_segment,'') &lt;&gt; ISNULL(s.customer_segment,'') OR ISNULL(d.customer_city,'') &lt;&gt; ISNULL(s.customer_city,''));&#xA;&#xA;    -- 2. Chèn phiên bản mới (SCD2) hoặc khách hàng mới&#xA;    INSERT INTO dbo.Dim_Customer (customer_id, customer_name, customer_age, age_group, gender, customer_segment, customer_type, customer_city, customer_state, customer_country, region, customer_postal_code, customer_acquisition_cost, is_current, effective_start)&#xA;    SELECT s.customer_id, s.customer_name, TRY_CONVERT(SMALLINT, s.customer_age),&#xA;        CASE WHEN TRY_CONVERT(SMALLINT, s.customer_age) &lt;= 25 THEN '18-25'&#xA;             WHEN TRY_CONVERT(SMALLINT, s.customer_age) &lt;= 35 THEN '26-35'&#xA;             WHEN TRY_CONVERT(SMALLINT, s.customer_age) &lt;= 50 THEN '36-50' ELSE '50+' END,&#xA;        s.gender, s.customer_segment, 'Standard', s.customer_city, s.customer_state, s.customer_country, s.region, s.customer_postal_code,&#xA;        TRY_CONVERT(DECIMAL(18,4), s.customer_acquisition_cost), 1, @today&#xA;    FROM dbo.stg_customer_master s&#xA;    WHERE s.customer_id IS NOT NULL&#xA;      AND NOT EXISTS (SELECT 1 FROM dbo.Dim_Customer d WHERE d.customer_id = s.customer_id AND d.is_current = 1);&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Customer', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Marketing_Campaign"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{88BFFC66-3BE7-4D37-83A7-AB523A68900B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Marketing_Campaign"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    INSERT INTO dbo.Dim_Marketing_Campaign (marketing_channel, campaign_name, coupon_code, has_coupon_flag)&#xA;    SELECT DISTINCT s.marketing_channel, s.campaign_name, ISNULL(s.coupon_code, 'NO_COUPON'),&#xA;        CASE WHEN s.coupon_code IS NOT NULL AND s.coupon_code &lt;&gt; '' THEN 1 ELSE 0 END&#xA;    FROM dbo.stg_sales_full s&#xA;    WHERE s.marketing_channel IS NOT NULL&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM dbo.Dim_Marketing_Campaign mc &#xA;          WHERE ISNULL(mc.marketing_channel,'') = ISNULL(s.marketing_channel,'') &#xA;            AND ISNULL(mc.campaign_name,'')     = ISNULL(s.campaign_name,'') &#xA;            AND ISNULL(mc.coupon_code,'NO_COUPON') = ISNULL(s.coupon_code,'NO_COUPON')&#xA;      );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Marketing_Campaign', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Order_Profile"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{10282087-5C32-402B-A634-AF14D9CD1475}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Order_Profile"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    INSERT INTO dbo.Dim_Order_Profile (order_status, payment_method, payment_status, sales_channel, delivery_status)&#xA;    SELECT DISTINCT s.order_status, s.payment_method, s.payment_status, s.sales_channel, s.delivery_status&#xA;    FROM dbo.stg_sales_full s&#xA;    WHERE s.order_status IS NOT NULL&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM dbo.Dim_Order_Profile op &#xA;          WHERE ISNULL(op.order_status,'')    = ISNULL(s.order_status,'') &#xA;            AND ISNULL(op.payment_method,'')  = ISNULL(s.payment_method,'') &#xA;            AND ISNULL(op.payment_status,'')  = ISNULL(s.payment_status,'') &#xA;            AND ISNULL(op.sales_channel,'')   = ISNULL(s.sales_channel,'') &#xA;            AND ISNULL(op.delivery_status,'') = ISNULL(s.delivery_status,'')&#xA;      );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Order_Profile', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Product_SCD1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3D8CC3C3-E093-4563-BCEF-617561D336D5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Product_SCD1"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    MERGE dbo.Dim_Product AS T&#xA;    USING (&#xA;        SELECT product_id, product_name, brand, product_category AS category,&#xA;               TRY_CONVERT(DECIMAL(18,4), unit_price) AS unit_price,&#xA;               TRY_CONVERT(DECIMAL(18,4), product_cost) AS product_cost&#xA;        FROM dbo.stg_product_catalog&#xA;        WHERE product_id IS NOT NULL&#xA;    ) AS S ON T.product_id = S.product_id&#xA;    WHEN MATCHED THEN&#xA;        UPDATE SET T.product_name = S.product_name, T.brand = S.brand, T.category = S.category,&#xA;                   T.unit_price = S.unit_price, T.product_cost = S.product_cost&#xA;    WHEN NOT MATCHED THEN&#xA;        INSERT (product_id, product_name, brand, category, unit_price, product_cost)&#xA;        VALUES (S.product_id, S.product_name, S.brand, S.category, S.unit_price, S.product_cost);&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Product', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Region"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{68A06735-CB8B-4162-8462-15B49ED619A5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Region"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    INSERT INTO dbo.Dim_Region (region, [state], country, default_currency_code)&#xA;    SELECT DISTINCT s.region, s.customer_state, s.customer_country, COALESCE(s.currency, 'USD')&#xA;    FROM dbo.stg_sales_full s&#xA;    WHERE s.region IS NOT NULL&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM dbo.Dim_Region r &#xA;          WHERE r.region = s.region &#xA;            AND ISNULL(r.[state],'') = ISNULL(s.customer_state,'') &#xA;            AND ISNULL(r.country,'') = ISNULL(s.customer_country,'')&#xA;      );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Region', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Return_Profile"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EEFDD6D6-B87D-408C-964C-6C2116AF5A8E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Return_Profile"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    INSERT INTO dbo.Dim_Return_Profile (return_status, return_reason)&#xA;    SELECT DISTINCT s.return_status, s.return_reason&#xA;    FROM dbo.stg_sales_full s&#xA;    WHERE s.return_status IS NOT NULL&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM dbo.Dim_Return_Profile rp &#xA;          WHERE ISNULL(rp.return_status,'') = ISNULL(s.return_status,'') &#xA;            AND ISNULL(rp.return_reason,'') = ISNULL(s.return_reason,'')&#xA;      );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Return_Profile', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Dim_Shipping"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{85DAE5F3-4282-492E-B02C-08EAF064B304}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Dim_Shipping"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="6">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    INSERT INTO dbo.Dim_Shipping (shipping_method, warehouse, shipping_speed_category)&#xA;    SELECT DISTINCT s.shipping_method, s.warehouse, 'Standard'&#xA;    FROM dbo.stg_sales_full s&#xA;    WHERE s.shipping_method IS NOT NULL&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM dbo.Dim_Shipping sh &#xA;          WHERE sh.shipping_method = s.shipping_method &#xA;            AND ISNULL(sh.warehouse,'') = ISNULL(s.warehouse,'')&#xA;      );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Dim_Shipping', 'DIM_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Load_Dim_Date"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{04326931-BBF4-41CD-A67A-A6F07698F6CF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Load_Dim_Date"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="7">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @StartDate DATE = '2020-01-01';&#xA;DECLARE @EndDate   DATE = '2030-12-31';&#xA;&#xA;;WITH DateSequence AS (&#xA;    SELECT @StartDate AS [Date]&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, [Date])&#xA;    FROM DateSequence&#xA;    WHERE [Date] &lt; @EndDate&#xA;)&#xA;INSERT INTO dbo.Dim_Date (&#xA;    date_key, full_date, [year], [quarter], quarter_name,&#xA;    [month], month_name, [day], day_of_week, day_of_week_num,&#xA;    is_weekend, week_of_year, year_month, season, is_month_end&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, CONVERT(VARCHAR(8), [Date], 112)),&#xA;    [Date],&#xA;    DATEPART(YEAR, [Date]),&#xA;    DATEPART(QUARTER, [Date]),&#xA;    CONCAT('Q', DATEPART(QUARTER, [Date])),&#xA;    DATEPART(MONTH, [Date]),&#xA;    DATENAME(MONTH, [Date]),&#xA;    DATEPART(DAY, [Date]),&#xA;    DATENAME(WEEKDAY, [Date]),&#xA;    ((DATEPART(WEEKDAY, [Date]) + 5) % 7) + 1,&#xA;    CASE WHEN DATEPART(WEEKDAY, [Date]) IN (1, 7) THEN 1 ELSE 0 END,&#xA;    DATEPART(ISO_WEEK, [Date]),&#xA;    CONVERT(CHAR(7), [Date], 120),&#xA;    CASE WHEN DATEPART(MONTH, [Date]) IN (3, 4, 5) THEN 'Spring'&#xA;         WHEN DATEPART(MONTH, [Date]) IN (6, 7, 8) THEN 'Summer'&#xA;         WHEN DATEPART(MONTH, [Date]) IN (9, 10, 11) THEN 'Autumn' ELSE 'Winter' END,&#xA;    CASE WHEN [Date] = EOMONTH([Date]) THEN 1 ELSE 0 END&#xA;FROM DateSequence&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dbo.Dim_Date d WHERE d.date_key = CONVERT(INT, CONVERT(VARCHAR(8), DateSequence.[Date], 112))&#xA;)&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04_Load_Fact_Tables"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{1784A7F7-07EE-4261-B627-5ACBB0468048}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="04_Load_Fact_Tables">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Campaign_Promotion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{84DD1810-7F95-45D6-9A1A-8B1ED3BA6FF4}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Campaign_Promotion"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    ;WITH DedupPromotion AS (&#xA;        SELECT &#xA;            s.order_id,&#xA;            ISNULL(CAST(CONVERT(VARCHAR(8), TRY_CONVERT(DATE, s.order_date), 112) AS INT), -1) AS date_key,&#xA;            ISNULL(c.customer_key, -1) AS customer_key,&#xA;            ISNULL(mc.marketing_key, -1) AS marketing_key,&#xA;            ISNULL(r.region_key, -1) AS region_key,&#xA;            ISNULL(op.order_profile_key, -1) AS order_profile_key,&#xA;            ISNULL(cur.currency_key, -1) AS currency_key,&#xA;            ISNULL(TRY_CONVERT(DECIMAL(18,4), s.gross_sales), 0) AS gross_sales,&#xA;            ISNULL(TRY_CONVERT(DECIMAL(18,4), s.discount_amount), 0) AS discount_amount,&#xA;            ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) AS net_revenue,&#xA;            ROUND(ISNULL(TRY_CONVERT(DECIMAL(18,4), s.gross_sales), 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS gross_sales_usd,&#xA;            ROUND(ISNULL(TRY_CONVERT(DECIMAL(18,4), s.discount_amount), 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS discount_amount_usd,&#xA;            ROUND(ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS net_revenue_usd,&#xA;            CASE WHEN TRY_CONVERT(DECIMAL(18,4), s.gross_sales) &gt; 0 &#xA;                 THEN ROUND(TRY_CONVERT(DECIMAL(18,4), s.discount_amount) / TRY_CONVERT(DECIMAL(18,4), s.gross_sales), 4) ELSE 0 END AS discount_rate,&#xA;            CASE WHEN s.coupon_code IS NOT NULL AND s.coupon_code &lt;&gt; '' AND s.coupon_code &lt;&gt; 'NO_COUPON' THEN 1 ELSE 0 END AS is_coupon_order,&#xA;            CASE WHEN s.coupon_code IS NOT NULL AND s.coupon_code &lt;&gt; '' THEN 'COUPON'&#xA;                 WHEN TRY_CONVERT(DECIMAL(18,4), s.discount_amount) &gt; 0 THEN 'AUTO_DISCOUNT' ELSE 'STANDARD' END AS discount_type,&#xA;            -- Khử trùng lặp tuyệt đối theo order_id:&#xA;            ROW_NUMBER() OVER (PARTITION BY s.order_id ORDER BY s.order_date DESC) AS rn_final&#xA;        FROM dbo.stg_sales_full s&#xA;        LEFT JOIN dbo.Dim_Customer c ON s.customer_id = c.customer_id AND c.is_current = 1&#xA;        LEFT JOIN dbo.Dim_Region r ON s.region = r.region AND s.customer_state = r.[state] AND s.customer_country = r.country&#xA;        LEFT JOIN dbo.Dim_Currency cur ON s.currency = cur.currency_code&#xA;        LEFT JOIN dbo.Dim_Marketing_Campaign mc ON&#xA;            ISNULL(s.marketing_channel, '') = ISNULL(mc.marketing_channel, '') AND&#xA;            ISNULL(s.campaign_name, '')     = ISNULL(mc.campaign_name, '') AND&#xA;            ISNULL(s.coupon_code, 'NO_COUPON') = ISNULL(mc.coupon_code, 'NO_COUPON')&#xA;        LEFT JOIN dbo.Dim_Order_Profile op ON &#xA;            ISNULL(s.order_status, '')   = ISNULL(op.order_status, '') AND&#xA;            ISNULL(s.payment_method, '') = ISNULL(op.payment_method, '') AND&#xA;            ISNULL(s.payment_status, '') = ISNULL(op.payment_status, '') AND&#xA;            ISNULL(s.sales_channel, '')  = ISNULL(op.sales_channel, '') AND&#xA;            ISNULL(s.delivery_status, '')= ISNULL(op.delivery_status, '')&#xA;        WHERE (TRY_CONVERT(DECIMAL(18,4), s.discount_amount) &gt; 0 OR (s.coupon_code IS NOT NULL AND s.coupon_code &lt;&gt; ''))&#xA;    )&#xA;    INSERT INTO dbo.Fact_Campaign_Promotion (&#xA;        order_id, date_key, customer_key, marketing_key, region_key, order_profile_key, currency_key,&#xA;        gross_sales, discount_amount, net_revenue, gross_sales_usd, discount_amount_usd, net_revenue_usd,&#xA;        discount_rate, is_coupon_order, discount_type&#xA;    )&#xA;    SELECT &#xA;        order_id, date_key, customer_key, marketing_key, region_key, order_profile_key, currency_key,&#xA;        gross_sales, discount_amount, net_revenue, gross_sales_usd, discount_amount_usd, net_revenue_usd,&#xA;        discount_rate, is_coupon_order, discount_type&#xA;    FROM DedupPromotion&#xA;    WHERE rn_final = 1&#xA;      AND NOT EXISTS (SELECT 1 FROM dbo.Fact_Campaign_Promotion fcp WHERE fcp.order_id = DedupPromotion.order_id);&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Campaign_Promotion', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Customer_Acquisition"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C55B4824-74AE-4DC6-BECA-CC9179695934}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Customer_Acquisition"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    ;WITH FirstOrders AS (&#xA;        SELECT &#xA;            s.customer_id, s.order_id, s.order_date, s.currency, s.marketing_channel, s.campaign_name, s.coupon_code,&#xA;            s.region, s.customer_state, s.customer_country,&#xA;            TRY_CONVERT(DECIMAL(18,4), s.net_sales) AS first_order_net_revenue,&#xA;            ROW_NUMBER() OVER (PARTITION BY s.customer_id ORDER BY TRY_CONVERT(DATE, s.order_date) ASC, s.order_id ASC) AS rn&#xA;        FROM dbo.stg_sales_full s&#xA;        WHERE s.customer_id IS NOT NULL AND TRY_CONVERT(DATE, s.order_date) IS NOT NULL&#xA;    )&#xA;    INSERT INTO dbo.Fact_Customer_Acquisition (&#xA;        customer_key, date_key, region_key, marketing_key, currency_key,&#xA;        customer_acquisition_cost, first_order_net_revenue,&#xA;        customer_acquisition_cost_usd, first_order_net_revenue_usd, new_customer_count&#xA;    )&#xA;    SELECT &#xA;        c.customer_key,&#xA;        ISNULL(CAST(CONVERT(VARCHAR(8), TRY_CONVERT(DATE, fo.order_date), 112) AS INT), -1),&#xA;        ISNULL(r.region_key, -1),&#xA;        ISNULL(mc.marketing_key, -1),&#xA;        ISNULL(cur.currency_key, -1),&#xA;        ISNULL(c.customer_acquisition_cost, 0),&#xA;        ISNULL(fo.first_order_net_revenue, 0),&#xA;        ROUND(ISNULL(c.customer_acquisition_cost, 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4),&#xA;        ROUND(ISNULL(fo.first_order_net_revenue, 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4),&#xA;        1&#xA;    FROM FirstOrders fo&#xA;    INNER JOIN dbo.Dim_Customer c ON fo.customer_id = c.customer_id AND c.is_current = 1&#xA;    LEFT JOIN dbo.Dim_Region r ON fo.region = r.region AND fo.customer_state = r.[state] AND fo.customer_country = r.country&#xA;    LEFT JOIN dbo.Dim_Currency cur ON fo.currency = cur.currency_code&#xA;    LEFT JOIN dbo.Dim_Marketing_Campaign mc ON&#xA;        ISNULL(fo.marketing_channel, '') = ISNULL(mc.marketing_channel, '') AND&#xA;        ISNULL(fo.campaign_name, '') = ISNULL(mc.campaign_name, '') AND&#xA;        ISNULL(fo.coupon_code, 'NO_COUPON') = ISNULL(mc.coupon_code, 'NO_COUPON')&#xA;    WHERE fo.rn = 1&#xA;      AND NOT EXISTS (SELECT 1 FROM dbo.Fact_Customer_Acquisition fca WHERE fca.customer_key = c.customer_key);&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Customer_Acquisition', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Customer_Feedback"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E894256D-31AF-4685-B303-9E044B729AA4}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Customer_Feedback"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    ;WITH DedupFeedback AS (&#xA;        SELECT &#xA;            s.order_id,&#xA;            ISNULL(CAST(CONVERT(VARCHAR(8), TRY_CONVERT(DATE, s.order_date), 112) AS INT), -1) AS date_key,&#xA;            ISNULL(c.customer_key, -1) AS customer_key,&#xA;            ISNULL(r.region_key, -1) AS region_key,&#xA;            ISNULL(op.order_profile_key, -1) AS order_profile_key,&#xA;            ISNULL(TRY_CONVERT(DECIMAL(5,2), s.customer_rating), 0) AS rating_value,&#xA;            ISNULL(s.review_sentiment, 'Neutral') AS review_sentiment,&#xA;            ISNULL(LEN(s.customer_review), 0) AS review_length,&#xA;            CASE WHEN s.review_sentiment = 'Negative' OR TRY_CONVERT(DECIMAL(5,2), s.customer_rating) &lt;= 2.0 THEN 1 ELSE 0 END AS is_negative_flag,&#xA;            1 AS review_count,&#xA;            -- Khử trùng lặp tuyệt đối theo order_id:&#xA;            ROW_NUMBER() OVER (PARTITION BY s.order_id ORDER BY s.order_date DESC) AS rn_final&#xA;        FROM dbo.stg_sales_full s&#xA;        LEFT JOIN dbo.Dim_Customer c ON s.customer_id = c.customer_id AND c.is_current = 1&#xA;        LEFT JOIN dbo.Dim_Region r ON s.region = r.region AND s.customer_state = r.[state] AND s.customer_country = r.country&#xA;        LEFT JOIN dbo.Dim_Order_Profile op ON &#xA;            ISNULL(s.order_status, '')   = ISNULL(op.order_status, '') AND&#xA;            ISNULL(s.payment_method, '') = ISNULL(op.payment_method, '') AND&#xA;            ISNULL(s.payment_status, '') = ISNULL(op.payment_status, '') AND&#xA;            ISNULL(s.sales_channel, '')  = ISNULL(op.sales_channel, '') AND&#xA;            ISNULL(s.delivery_status, '')= ISNULL(op.delivery_status, '')&#xA;        WHERE s.customer_rating IS NOT NULL&#xA;    )&#xA;    INSERT INTO dbo.Fact_Customer_Feedback (&#xA;        order_id, date_key, customer_key, region_key, order_profile_key,&#xA;        rating_value, review_sentiment, review_length, is_negative_flag, review_count&#xA;    )&#xA;    SELECT &#xA;        order_id, date_key, customer_key, region_key, order_profile_key,&#xA;        rating_value, review_sentiment, review_length, is_negative_flag, review_count&#xA;    FROM DedupFeedback&#xA;    WHERE rn_final = 1&#xA;      AND NOT EXISTS (SELECT 1 FROM dbo.Fact_Customer_Feedback fb WHERE fb.order_id = DedupFeedback.order_id);&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Customer_Feedback', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Customer_Snapshot"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0167B60F-9A50-4EC4-8188-DF365A8DEFDD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Customer_Snapshot"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    ;WITH MonthlyAgg AS (&#xA;        SELECT &#xA;            c.customer_key,&#xA;            EOMONTH(TRY_CONVERT(DATE, s.order_date)) AS month_end_date,&#xA;            SUM(ROUND(TRY_CONVERT(DECIMAL(18,4), s.net_sales) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4)) AS month_net_revenue_usd,&#xA;            COUNT(DISTINCT s.order_id) AS month_order_count,&#xA;            SUM(TRY_CONVERT(INT, s.loyalty_points_earned)) AS month_points_earned,&#xA;            SUM(TRY_CONVERT(INT, s.loyalty_points_redeemed)) AS month_points_redeemed,&#xA;            MAX(TRY_CONVERT(DATE, s.order_date)) AS max_order_date&#xA;        FROM dbo.stg_sales_full s&#xA;        INNER JOIN dbo.Dim_Customer c ON s.customer_id = c.customer_id AND c.is_current = 1&#xA;        LEFT JOIN dbo.Dim_Currency cur ON s.currency = cur.currency_code&#xA;        WHERE TRY_CONVERT(DATE, s.order_date) IS NOT NULL&#xA;        GROUP BY c.customer_key, EOMONTH(TRY_CONVERT(DATE, s.order_date))&#xA;    ),&#xA;    CumulativeAgg AS (&#xA;        SELECT &#xA;            ma.customer_key,&#xA;            CAST(CONVERT(VARCHAR(8), ma.month_end_date, 112) AS INT) AS snapshot_date_key,&#xA;            ma.month_net_revenue_usd,&#xA;            ma.month_order_count,&#xA;            SUM(ma.month_net_revenue_usd) OVER (PARTITION BY ma.customer_key ORDER BY ma.month_end_date ROWS UNBOUNDED PRECEDING) AS cumulative_net_revenue_usd,&#xA;            SUM(ma.month_order_count) OVER (PARTITION BY ma.customer_key ORDER BY ma.month_end_date ROWS UNBOUNDED PRECEDING) AS cumulative_order_count,&#xA;            ISNULL(SUM(ma.month_points_earned) OVER (PARTITION BY ma.customer_key ORDER BY ma.month_end_date ROWS UNBOUNDED PRECEDING), 0) AS cumulative_points_earned,&#xA;            ISNULL(SUM(ma.month_points_redeemed) OVER (PARTITION BY ma.customer_key ORDER BY ma.month_end_date ROWS UNBOUNDED PRECEDING), 0) AS cumulative_points_redeemed,&#xA;            DATEDIFF(DAY, ma.max_order_date, ma.month_end_date) AS days_since_last_order&#xA;        FROM MonthlyAgg ma&#xA;    )&#xA;    INSERT INTO dbo.Fact_Customer_Snapshot (&#xA;        snapshot_date_key, customer_key, cumulative_net_revenue_usd, cumulative_order_count,&#xA;        cumulative_points_earned, cumulative_points_redeemed, active_90d_flag, customer_count,&#xA;        month_net_revenue_usd, month_order_count, days_since_last_order, rfm_score, loyalty_tier&#xA;    )&#xA;    SELECT &#xA;        ca.snapshot_date_key, ca.customer_key, ca.cumulative_net_revenue_usd, ca.cumulative_order_count,&#xA;        ca.cumulative_points_earned, ca.cumulative_points_redeemed,&#xA;        CASE WHEN ca.days_since_last_order &lt;= 90 THEN 1 ELSE 0 END,&#xA;        1, ca.month_net_revenue_usd, ca.month_order_count, ca.days_since_last_order,&#xA;        CASE WHEN ca.days_since_last_order &lt;= 30 THEN 5&#xA;             WHEN ca.days_since_last_order &lt;= 60 THEN 4&#xA;             WHEN ca.days_since_last_order &lt;= 90 THEN 3&#xA;             WHEN ca.days_since_last_order &lt;= 180 THEN 2 ELSE 1 END,&#xA;        CASE WHEN ca.cumulative_net_revenue_usd &gt;= 10000 THEN 'Platinum'&#xA;             WHEN ca.cumulative_net_revenue_usd &gt;= 5000  THEN 'Gold'&#xA;             WHEN ca.cumulative_net_revenue_usd &gt;= 2000  THEN 'Silver' ELSE 'Bronze' END&#xA;    FROM CumulativeAgg ca&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1 FROM dbo.Fact_Customer_Snapshot fcs &#xA;        WHERE fcs.snapshot_date_key = ca.snapshot_date_key AND fcs.customer_key = ca.customer_key&#xA;    );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Customer_Snapshot', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Order_Fulfillment"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{288718C6-0700-49D6-AB30-C339B8D110DA}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Order_Fulfillment"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    ;WITH DedupFulfillment AS (&#xA;        SELECT &#xA;            s.order_id,&#xA;            ISNULL(CAST(CONVERT(VARCHAR(8), TRY_CONVERT(DATE, s.order_date), 112) AS INT), -1) AS order_date_key,&#xA;            ISNULL(CAST(CONVERT(VARCHAR(8), DATEADD(DAY, TRY_CONVERT(INT, TRY_CONVERT(FLOAT, s.estimated_delivery_days)), TRY_CONVERT(DATE, s.order_date)), 112) AS INT), -1) AS expected_delivery_date_key,&#xA;            CASE WHEN s.delivery_days IS NOT NULL AND TRY_CONVERT(FLOAT, s.delivery_days) &gt;= 0&#xA;                 THEN ISNULL(CAST(CONVERT(VARCHAR(8), DATEADD(DAY, TRY_CONVERT(INT, TRY_CONVERT(FLOAT, s.delivery_days)), TRY_CONVERT(DATE, s.order_date)), 112) AS INT), -1)&#xA;                 ELSE -1 END AS actual_delivery_date_key,&#xA;            ISNULL(c.customer_key, -1) AS customer_key,&#xA;            ISNULL(r.region_key, -1) AS region_key,&#xA;            ISNULL(shp.shipping_key, -1) AS shipping_key,&#xA;            ISNULL(op.order_profile_key, -1) AS order_profile_key,&#xA;            ISNULL(cur.currency_key, -1) AS currency_key,&#xA;            ISNULL(TRY_CONVERT(SMALLINT, TRY_CONVERT(FLOAT, s.delivery_days)), 0) AS delivery_days,&#xA;            ISNULL(TRY_CONVERT(SMALLINT, TRY_CONVERT(FLOAT, s.estimated_delivery_days)), 0) AS estimated_delivery_days,&#xA;            ISNULL(TRY_CONVERT(SMALLINT, TRY_CONVERT(FLOAT, s.delivery_days)), 0) - ISNULL(TRY_CONVERT(SMALLINT, TRY_CONVERT(FLOAT, s.estimated_delivery_days)), 0) AS delivery_variance_days,&#xA;            CASE WHEN TRY_CONVERT(FLOAT, s.delivery_days) &gt; TRY_CONVERT(FLOAT, s.estimated_delivery_days) THEN 1 ELSE 0 END AS late_flag,&#xA;            ISNULL(TRY_CONVERT(DECIMAL(18,4), s.shipping_cost), 0) AS shipping_cost,&#xA;            ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) AS order_net_revenue,&#xA;            ROUND(ISNULL(TRY_CONVERT(DECIMAL(18,4), s.shipping_cost), 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS shipping_cost_usd,&#xA;            ROUND(ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS order_net_revenue_usd,&#xA;            -- Khử trùng lặp tuyệt đối theo order_id:&#xA;            ROW_NUMBER() OVER (PARTITION BY s.order_id ORDER BY s.order_date DESC) AS rn_final&#xA;        FROM dbo.stg_sales_full s&#xA;        LEFT JOIN dbo.Dim_Customer c ON s.customer_id = c.customer_id AND c.is_current = 1&#xA;        LEFT JOIN dbo.Dim_Region r ON s.region = r.region AND s.customer_state = r.[state] AND s.customer_country = r.country&#xA;        LEFT JOIN dbo.Dim_Shipping shp ON s.shipping_method = shp.shipping_method AND s.warehouse = shp.warehouse&#xA;        LEFT JOIN dbo.Dim_Currency cur ON s.currency = cur.currency_code&#xA;        LEFT JOIN dbo.Dim_Order_Profile op ON &#xA;            ISNULL(s.order_status, '')   = ISNULL(op.order_status, '') AND&#xA;            ISNULL(s.payment_method, '') = ISNULL(op.payment_method, '') AND&#xA;            ISNULL(s.payment_status, '') = ISNULL(op.payment_status, '') AND&#xA;            ISNULL(s.sales_channel, '')  = ISNULL(op.sales_channel, '') AND&#xA;            ISNULL(s.delivery_status, '')= ISNULL(op.delivery_status, '')&#xA;        WHERE TRY_CONVERT(DATE, s.order_date) IS NOT NULL&#xA;    )&#xA;    MERGE dbo.Fact_Order_Fulfillment AS TARGET&#xA;    USING (&#xA;        SELECT * FROM DedupFulfillment WHERE rn_final = 1&#xA;    ) AS SOURCE&#xA;    ON (TARGET.order_id = SOURCE.order_id)&#xA;    WHEN MATCHED AND (TARGET.actual_delivery_date_key = -1 AND SOURCE.actual_delivery_date_key &lt;&gt; -1) THEN&#xA;        UPDATE SET &#xA;            TARGET.actual_delivery_date_key = SOURCE.actual_delivery_date_key,&#xA;            TARGET.delivery_days            = SOURCE.delivery_days,&#xA;            TARGET.delivery_variance_days   = SOURCE.delivery_variance_days,&#xA;            TARGET.late_flag                = SOURCE.late_flag&#xA;    WHEN NOT MATCHED THEN&#xA;        INSERT (&#xA;            order_id, order_date_key, expected_delivery_date_key, actual_delivery_date_key,&#xA;            customer_key, region_key, shipping_key, order_profile_key, currency_key,&#xA;            delivery_days, estimated_delivery_days, delivery_variance_days,&#xA;            late_flag, shipping_cost, order_net_revenue, shipping_cost_usd, order_net_revenue_usd&#xA;        )&#xA;        VALUES (&#xA;            SOURCE.order_id, SOURCE.order_date_key, SOURCE.expected_delivery_date_key, SOURCE.actual_delivery_date_key,&#xA;            SOURCE.customer_key, SOURCE.region_key, SOURCE.shipping_key, SOURCE.order_profile_key, SOURCE.currency_key,&#xA;            SOURCE.delivery_days, SOURCE.estimated_delivery_days, SOURCE.delivery_variance_days,&#xA;            SOURCE.late_flag, SOURCE.shipping_cost, SOURCE.order_net_revenue, SOURCE.shipping_cost_usd, SOURCE.order_net_revenue_usd&#xA;        );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Order_Fulfillment', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Return"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8795FA69-F4AC-4803-ACFD-63E3BBE108F4}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Return"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    INSERT INTO dbo.Fact_Return (&#xA;        order_id, date_key, return_date_key, customer_key, region_key, shipping_key, return_profile_key, currency_key,&#xA;        returned_net_revenue, returned_product_cost, return_margin_impact, returned_net_revenue_usd, return_margin_impact_usd&#xA;    )&#xA;    SELECT &#xA;        s.order_id,&#xA;        ISNULL(CAST(CONVERT(VARCHAR(8), TRY_CONVERT(DATE, s.order_date), 112) AS INT), -1),&#xA;        ISNULL(CAST(CONVERT(VARCHAR(8), DATEADD(DAY, ISNULL(TRY_CONVERT(INT, TRY_CONVERT(FLOAT, s.delivery_days)), 3), TRY_CONVERT(DATE, s.order_date)), 112) AS INT), -1),&#xA;        ISNULL(c.customer_key, -1),&#xA;        ISNULL(r.region_key, -1),&#xA;        ISNULL(shp.shipping_key, -1),&#xA;        ISNULL(rp.return_profile_key, -1),&#xA;        ISNULL(cur.currency_key, -1),&#xA;        ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0),&#xA;        ISNULL(TRY_CONVERT(DECIMAL(18,4), s.product_cost), 0),&#xA;        -1.0 * (ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) - ISNULL(TRY_CONVERT(DECIMAL(18,4), s.product_cost), 0)),&#xA;        ROUND(ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4),&#xA;        ROUND(-1.0 * (ISNULL(TRY_CONVERT(DECIMAL(18,4), s.net_sales), 0) - ISNULL(TRY_CONVERT(DECIMAL(18,4), s.product_cost), 0)) * ISNULL(cur.exchange_rate_to_usd, 1.0), 4)&#xA;    FROM dbo.stg_sales_full s&#xA;    LEFT JOIN dbo.Dim_Customer c ON s.customer_id = c.customer_id AND c.is_current = 1&#xA;    LEFT JOIN dbo.Dim_Region r ON s.region = r.region AND s.customer_state = r.[state] AND s.customer_country = r.country&#xA;    LEFT JOIN dbo.Dim_Shipping shp ON s.shipping_method = shp.shipping_method AND s.warehouse = shp.warehouse&#xA;    LEFT JOIN dbo.Dim_Currency cur ON s.currency = cur.currency_code&#xA;    LEFT JOIN dbo.Dim_Return_Profile rp ON ISNULL(s.return_status, '') = ISNULL(rp.return_status, '') AND ISNULL(s.return_reason, '') = ISNULL(rp.return_reason, '')&#xA;    WHERE s.return_status = 'Returned'&#xA;      AND NOT EXISTS (SELECT 1 FROM dbo.Fact_Return fr WHERE fr.order_id = s.order_id);&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Return', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\04_Load_Fact_Tables\SQL_Fact_Sales"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A99B0D81-409D-4A34-99DC-387C798614B8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Fact_Sales"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="6">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id  INT  = ?;&#xA;DECLARE @load_from DATE = ?;&#xA;DECLARE @load_to   DATE = ?;&#xA;&#xA;BEGIN TRY&#xA;    ;WITH DedupSalesFull AS (&#xA;        SELECT *, ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY order_date DESC) AS rn_sales&#xA;        FROM dbo.stg_sales_full&#xA;    ),&#xA;    DeduplicatedItems AS (&#xA;        SELECT &#xA;            oi.order_id, oi.product_id,&#xA;            TRY_CONVERT(INT, oi.quantity) AS quantity,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.gross_sales) AS gross_sales,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.discount_amount) AS discount_amount,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.tax_amount) AS tax_amount,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.net_sales) AS net_revenue,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.product_cost) AS product_cost,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.shipping_cost) AS shipping_cost_allocated,&#xA;            TRY_CONVERT(DECIMAL(18,4), oi.profit) AS contribution_margin,&#xA;            ROW_NUMBER() OVER (PARTITION BY oi.order_id, oi.product_id ORDER BY oi.quantity DESC) AS rn_item&#xA;        FROM dbo.stg_order_items oi&#xA;    ),&#xA;    RawFactSales AS (&#xA;        SELECT &#xA;            di.order_id,&#xA;            ISNULL(p.product_key, -1) AS product_key,&#xA;            ISNULL(CAST(CONVERT(VARCHAR(8), TRY_CONVERT(DATE, s.order_date), 112) AS INT), -1) AS date_key,&#xA;            ISNULL(c.customer_key, -1) AS customer_key,&#xA;            ISNULL(r.region_key, -1) AS region_key,&#xA;            ISNULL(op.order_profile_key, -1) AS order_profile_key,&#xA;            ISNULL(mc.marketing_key, -1) AS marketing_key,&#xA;            ISNULL(cur.currency_key, -1) AS currency_key,&#xA;            di.quantity, di.gross_sales, di.discount_amount, di.tax_amount, di.net_revenue, di.product_cost, di.shipping_cost_allocated, di.contribution_margin,&#xA;            ROUND(di.gross_sales * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS gross_sales_usd,&#xA;            ROUND(di.net_revenue * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS net_revenue_usd,&#xA;            ROUND(di.product_cost * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS product_cost_usd,&#xA;            ROUND(di.contribution_margin * ISNULL(cur.exchange_rate_to_usd, 1.0), 4) AS contribution_margin_usd,&#xA;            -- Chốt chặn khử trùng tuyệt đối theo Khóa chính (order_id, product_key):&#xA;            ROW_NUMBER() OVER (PARTITION BY di.order_id, ISNULL(p.product_key, -1) ORDER BY di.quantity DESC) AS rn_final&#xA;        FROM DeduplicatedItems di&#xA;        INNER JOIN DedupSalesFull s ON di.order_id = s.order_id AND s.rn_sales = 1&#xA;        LEFT JOIN dbo.Dim_Product p ON di.product_id = p.product_id&#xA;        LEFT JOIN dbo.Dim_Customer c ON s.customer_id = c.customer_id AND c.is_current = 1&#xA;        LEFT JOIN dbo.Dim_Region r ON s.region = r.region AND s.customer_state = r.[state] AND s.customer_country = r.country&#xA;        LEFT JOIN dbo.Dim_Currency cur ON s.currency = cur.currency_code&#xA;        LEFT JOIN dbo.Dim_Order_Profile op ON &#xA;            ISNULL(s.order_status, '')   = ISNULL(op.order_status, '') AND&#xA;            ISNULL(s.payment_method, '') = ISNULL(op.payment_method, '') AND&#xA;            ISNULL(s.payment_status, '') = ISNULL(op.payment_status, '') AND&#xA;            ISNULL(s.sales_channel, '')  = ISNULL(op.sales_channel, '') AND&#xA;            ISNULL(s.delivery_status, '')= ISNULL(op.delivery_status, '')&#xA;        LEFT JOIN dbo.Dim_Marketing_Campaign mc ON&#xA;            ISNULL(s.marketing_channel, '') = ISNULL(mc.marketing_channel, '') AND&#xA;            ISNULL(s.campaign_name, '')     = ISNULL(mc.campaign_name, '') AND&#xA;            ISNULL(s.coupon_code, 'NO_COUPON') = ISNULL(mc.coupon_code, 'NO_COUPON')&#xA;        WHERE di.rn_item = 1&#xA;          AND TRY_CONVERT(DATE, s.order_date) BETWEEN @load_from AND @load_to&#xA;    )&#xA;    INSERT INTO dbo.Fact_Sales (&#xA;        order_id, product_key, date_key, customer_key, region_key, order_profile_key, marketing_key, currency_key,&#xA;        quantity, gross_sales, discount_amount, tax_amount, net_revenue, product_cost, shipping_cost_allocated, contribution_margin,&#xA;        gross_sales_usd, net_revenue_usd, product_cost_usd, contribution_margin_usd&#xA;    )&#xA;    SELECT &#xA;        order_id, product_key, date_key, customer_key, region_key, order_profile_key, marketing_key, currency_key,&#xA;        quantity, gross_sales, discount_amount, tax_amount, net_revenue, product_cost, shipping_cost_allocated, contribution_margin,&#xA;        gross_sales_usd, net_revenue_usd, product_cost_usd, contribution_margin_usd&#xA;    FROM RawFactSales&#xA;    WHERE rn_final = 1&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM dbo.Fact_Sales fs &#xA;          WHERE fs.order_id = RawFactSales.order_id AND fs.product_key = RawFactSales.product_key&#xA;      );&#xA;END TRY&#xA;BEGIN CATCH&#xA;    INSERT INTO dbo.etl_reject (batch_id, source_table, reject_category, reject_reason)&#xA;    VALUES (@batch_id, 'Fact_Sales', 'FACT_LOAD_ERROR', ERROR_MESSAGE());&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::LoadFrom"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="7"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="User::LoadTo"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="7"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
