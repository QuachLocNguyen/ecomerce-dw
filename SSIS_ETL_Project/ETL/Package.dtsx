          DTS:DTSID="{CAEB5EEA-352E-466D-9D1D-D25D8B9E7B62}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_End_Batch_Success"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;UPDATE dbo.etl_batch&#xA;SET finished_at   = SYSDATETIME(),&#xA;    status        = 'SUCCESS',&#xA;    rows_after    = (SELECT COUNT(*) FROM dbo.Fact_Sales),&#xA;    rows_rejected = (SELECT COUNT(*) FROM dbo.etl_reject WHERE batch_id = @batch_id)&#xA;WHERE batch_id = @batch_id;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
