        <DTS:Executable
          DTS:refId="Package\00_Pre-ETL_Setup\SQL_Seed_And_Unknown_Keys"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CBAA0833-D46E-4E93-8F6A-BC71D95AF7C2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Seed_And_Unknown_Keys"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0958D35A-C78D-4D82-84E5-A060E05484E3}"
              SQLTask:SqlStatementSource="USE EcommerceDW;&#xA;&#xA;-- 1. NẠP KHÓA -1 VÀ -2 CHO DIM_DATE&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Date WHERE date_key = -1)&#xA;    INSERT INTO dbo.Dim_Date (date_key, full_date, [year], [quarter], quarter_name, [month], month_name, [day], day_of_week, day_of_week_num, is_weekend, week_of_year, year_month, season, is_month_end)&#xA;    VALUES (-1, '1900-01-01', 1900, 1, 'Q1', 1, 'January', 1, 'Monday', 1, 0, 1, '1900-01', 'Unknown', 0);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Date WHERE date_key = -2)&#xA;    INSERT INTO dbo.Dim_Date (date_key, full_date, [year], [quarter], quarter_name, [month], month_name, [day], day_of_week, day_of_week_num, is_weekend, week_of_year, year_month, season, is_month_end)&#xA;    VALUES (-2, '1900-01-02', 1900, 1, 'Q1', 1, 'January', 2, 'Tuesday', 2, 0, 1, '1900-01', 'N/A', 0);&#xA;&#xA;-- 2. NẠP 7 NGOẠI TỆ + KHÓA -1, -2 CHO DIM_CURRENCY&#xA;SET IDENTITY_INSERT dbo.Dim_Currency ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Currency WHERE currency_key = -1)&#xA;    INSERT INTO dbo.Dim_Currency (currency_key, currency_code, currency_name, country, exchange_rate_to_usd, symbol, is_base_currency)&#xA;    VALUES (-1, 'UNK', N'Ngoại tệ chưa rõ', N'Unknown', 1.0, N'?', 0);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Currency WHERE currency_key = -2)&#xA;    INSERT INTO dbo.Dim_Currency (currency_key, currency_code, currency_name, country, exchange_rate_to_usd, symbol, is_base_currency)&#xA;    VALUES (-2, 'NA ', N'Không áp dụng',    N'N/A',     1.0, N'-', 0);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Currency WHERE currency_code = 'USD')&#xA;    INSERT INTO dbo.Dim_Currency (currency_key, currency_code, currency_name, country, exchange_rate_to_usd, symbol, is_base_currency)&#xA;    VALUES &#xA;    (1, 'USD', N'US Dollar',          N'USA',         1.000000, N'$',   1),&#xA;    (2, 'EUR', N'Euro',               N'Germany',     1.085000, N'€',   0),&#xA;    (3, 'GBP', N'British Pound',      N'UK',          1.282000, N'£',   0),&#xA;    (4, 'AUD', N'Australian Dollar',  N'Australia',   0.655000, N'A$',  0),&#xA;    (5, 'CAD', N'Canadian Dollar',    N'Canada',      0.735000, N'C$',  0),&#xA;    (6, 'INR', N'Indian Rupee',       N'India',       0.012000, N'₹',   0),&#xA;    (7, 'AED', N'UAE Dirham',         N'UAE',         0.272300, N'د.إ', 0);&#xA;SET IDENTITY_INSERT dbo.Dim_Currency OFF;&#xA;&#xA;-- 3. NẠP KHÓA -1, -2 CHO DIM_CUSTOMER&#xA;SET IDENTITY_INSERT dbo.Dim_Customer ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Customer WHERE customer_key = -1)&#xA;    INSERT INTO dbo.Dim_Customer (customer_key, customer_id, customer_name, customer_segment, customer_type, is_current, effective_start)&#xA;    VALUES (-1, 'UNKNOWN', N'Khách vãng lai / Chưa rõ', 'Unknown', 'Unknown', 1, '1900-01-01');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Customer WHERE customer_key = -2)&#xA;    INSERT INTO dbo.Dim_Customer (customer_key, customer_id, customer_name, customer_segment, customer_type, is_current, effective_start)&#xA;    VALUES (-2, 'NA',      N'Không áp dụng',            'N/A',     'N/A',     1, '1900-01-01');&#xA;SET IDENTITY_INSERT dbo.Dim_Customer OFF;&#xA;&#xA;-- 4. NẠP KHÓA -1, -2 CHO DIM_PRODUCT&#xA;SET IDENTITY_INSERT dbo.Dim_Product ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Product WHERE product_key = -1)&#xA;    INSERT INTO dbo.Dim_Product (product_key, product_id, product_name, category, brand, supplier, unit_price, product_cost)&#xA;    VALUES (-1, 'UNKNOWN', N'Sản phẩm không xác định', 'Unknown', 'Unknown', 'Unknown', 0, 0);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Product WHERE product_key = -2)&#xA;    INSERT INTO dbo.Dim_Product (product_key, product_id, product_name, category, brand, supplier, unit_price, product_cost)&#xA;    VALUES (-2, 'NA',      N'Không áp dụng',           'N/A',     'N/A',     'N/A',     0, 0);&#xA;SET IDENTITY_INSERT dbo.Dim_Product OFF;&#xA;&#xA;-- 5. NẠP KHÓA -1, -2 CHO DIM_REGION&#xA;SET IDENTITY_INSERT dbo.Dim_Region ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Region WHERE region_key = -1)&#xA;    INSERT INTO dbo.Dim_Region (region_key, region, [state], country, continent, timezone, default_currency_code)&#xA;    VALUES (-1, 'Unknown', 'Unknown', 'Unknown', 'Unknown', 'Unknown', 'USD');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Region WHERE region_key = -2)&#xA;    INSERT INTO dbo.Dim_Region (region_key, region, [state], country, continent, timezone, default_currency_code)&#xA;    VALUES (-2, 'N/A',     'N/A',     'N/A',     'N/A',     'N/A',     'USD');&#xA;SET IDENTITY_INSERT dbo.Dim_Region OFF;&#xA;&#xA;-- 6. NẠP KHÓA -1, -2 CHO DIM_SHIPPING&#xA;SET IDENTITY_INSERT dbo.Dim_Shipping ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Shipping WHERE shipping_key = -1)&#xA;    INSERT INTO dbo.Dim_Shipping (shipping_key, shipping_method, warehouse, shipping_speed_category)&#xA;    VALUES (-1, 'Unknown', 'Unknown', 'Unknown');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Shipping WHERE shipping_key = -2)&#xA;    INSERT INTO dbo.Dim_Shipping (shipping_key, shipping_method, warehouse, shipping_speed_category)&#xA;    VALUES (-2, 'N/A',     'N/A',     'N/A');&#xA;SET IDENTITY_INSERT dbo.Dim_Shipping OFF;&#xA;&#xA;-- 7. NẠP KHÓA -1, -2 CHO DIM_ORDER_PROFILE&#xA;SET IDENTITY_INSERT dbo.Dim_Order_Profile ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Order_Profile WHERE order_profile_key = -1)&#xA;    INSERT INTO dbo.Dim_Order_Profile (order_profile_key, order_status, payment_method, payment_status, sales_channel, delivery_status)&#xA;    VALUES (-1, 'Unknown', 'Unknown', 'Unknown', 'Unknown', 'Unknown');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Order_Profile WHERE order_profile_key = -2)&#xA;    INSERT INTO dbo.Dim_Order_Profile (order_profile_key, order_status, payment_method, payment_status, sales_channel, delivery_status)&#xA;    VALUES (-2, 'N/A',     'N/A',     'N/A',     'N/A',     'N/A');&#xA;SET IDENTITY_INSERT dbo.Dim_Order_Profile OFF;&#xA;&#xA;-- 8. NẠP KHÓA -1, -2 CHO DIM_MARKETING_CAMPAIGN&#xA;SET IDENTITY_INSERT dbo.Dim_Marketing_Campaign ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Marketing_Campaign WHERE marketing_key = -1)&#xA;    INSERT INTO dbo.Dim_Marketing_Campaign (marketing_key, marketing_channel, campaign_name, coupon_code, has_coupon_flag, channel_type)&#xA;    VALUES (-1, 'Unknown', 'Unknown', 'NO_COUPON', 0, 'Unknown');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Marketing_Campaign WHERE marketing_key = -2)&#xA;    INSERT INTO dbo.Dim_Marketing_Campaign (marketing_key, marketing_channel, campaign_name, coupon_code, has_coupon_flag, channel_type)&#xA;    VALUES (-2, 'N/A',     'N/A',     'NO_COUPON', 0, 'N/A');&#xA;SET IDENTITY_INSERT dbo.Dim_Marketing_Campaign OFF;&#xA;&#xA;-- 9. NẠP KHÓA -1, -2 CHO DIM_RETURN_PROFILE&#xA;SET IDENTITY_INSERT dbo.Dim_Return_Profile ON;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Return_Profile WHERE return_profile_key = -1)&#xA;    INSERT INTO dbo.Dim_Return_Profile (return_profile_key, return_status, return_reason, return_reason_category)&#xA;    VALUES (-1, 'Unknown', 'Unknown', 'Unknown');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Return_Profile WHERE return_profile_key = -2)&#xA;    INSERT INTO dbo.Dim_Return_Profile (return_profile_key, return_status, return_reason, return_reason_category)&#xA;    VALUES (-2, 'N/A',     'N/A',     'N/A');&#xA;SET IDENTITY_INSERT dbo.Dim_Return_Profile OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
